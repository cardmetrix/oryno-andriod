{
  "name": "oryno-africa",
  "main": "expo-router/entry",
  "version": "0.2.0",
  "scripts": {
    "start": "expo start",
    "start:prod-api": "EXPO_PUBLIC_API_URL=https://www.orynoafrica.com EXPO_PUBLIC_API_PREFIX=/api/external/v1 expo start -c",
    "start:local-api": "EXPO_PUBLIC_API_URL=http://172.20.10.7:3000 EXPO_PUBLIC_API_PREFIX=/api expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas": "pnpm dlx eas-cli@latest",
    "eas:init": "pnpm dlx eas-cli@latest init",
    "eas:login": "pnpm dlx eas-cli@latest login",
    "eas:logout": "pnpm dlx eas-cli@latest logout",
    "eas:whoami": "pnpm dlx eas-cli@latest whoami",
    "eas:build:apk": "pnpm dlx eas-cli@latest build --platform android --profile preview",
    "eas:build:production": "pnpm dlx eas-cli@latest build --platform android --profile production",
    "eas:build:ios": "pnpm dlx eas-cli@latest build --platform ios --profile production",
    "eas:env:push:production": "pnpm dlx eas-cli@latest env:push --environment production --path .env.eas --force"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-contacts": "^57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
